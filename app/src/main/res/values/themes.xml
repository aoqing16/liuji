<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.留迹" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.留迹.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/page_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.留迹</item>
    </style>
</resources>
